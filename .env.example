[TEMPLATE]
[TEMPLATE]
# Telegram Login uchun bot username
# @BotFather orqali bot yarating va quyidagiga yozing:
# VITE_TG_BOT=janob_hotdog_bot
VITE_TG_BOT=YOUR_BOT_USERNAME

# Admin panel paroli — albatta o'zgartiring!
VITE_ADMIN_PASSWORD=changeme

# Telegram bot tokeni (server tomonida) — @BotFather dan oling.
# Bot /start bosilganda foydalanuvchiga salomlashish xabari yuboradi.
# Webhookni ro'yxatdan o'tkazish: npm run tg:set-webhook -- https://sizning-saytingiz.uz
TELEGRAM_BOT_TOKEN=

# Saytning ochiq HTTPS manzili (server tomonida).
# Botdagi "Akkountni ulash" tugmasi shu manzilga qaytaradi:
# SITE_URL=https://janob-hotdog.uz
SITE_URL=

# Buyurtma xabarlari boradigan Telegram chat ID (egasi).
# ID'ni bilish uchun botga /start bosing — bot javobida "Sizning chat ID" ko'rinadi.
# KV o'rnatilmagan bo'lsa ham buyurtmalar Telegram'ga keladi:
# OWNER_CHAT_ID=123456789
OWNER_CHAT_ID=

# Oshpazlar kanali/chat ID — har bir buyurtma shu kanalga "✅ Tayyor" tugmasi
# bilan tashlanadi (yetkazib berish ham, olib ketish ham — bitta kanal).
# Bot kanalda admin bo'lishi shart. Kanal ID'ni bilish:
#  - kanalga botni admin qilib qo'shing va bitta xabar yozing, so'ng
#    https://api.telegram.org/bot<TOKEN>/getUpdates orqali "chat":{"id":...}
#    (kanallar uchun -100... dan boshlanadi) ni oling, yoki
#  - botga /start bosing va javobdagi chat ID'ni ishlating.
# COOKS_CHAT_ID=-1001234567890
COOKS_CHAT_ID=

# Yetkazib beruvchilar kanali/chat ID — oshpazlar "✅ Tayyor" tugmasini
# bosgach, yetkazib berish buyurtmasi shu kanalga "🚚 Yetkazildi" tugmasi
# bilan tashlanadi. Bot kanalda admin bo'lishi shart:
# COURIERS_CHAT_ID=-1001234567890
COURIERS_CHAT_ID=
